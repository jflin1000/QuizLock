<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="48dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="40sp"
            android:textColor="@color/accent"
            android:layout_marginBottom="32dp"/>

        <LinearLayout
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/enabled_label"
                android:textSize="26sp"
                android:textColor="@color/text_primary"/>
            <CheckBox
                android:id="@+id/cb_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="1.5"
                android:scaleY="1.5"
                android:focusable="true"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/interval_label"
                android:textSize="26sp"
                android:textColor="@color/text_primary"/>
            <EditText
                android:id="@+id/et_interval"
                android:layout_width="120dp"
                android:layout_height="56dp"
                android:inputType="number"
                android:gravity="center"
                android:textSize="26sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/card_bg"
                android:focusable="true"/>
        </LinearLayout>

        <TextView
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:text="修改家长密码（4位数字）"
            android:textSize="22sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/et_new_pin"
            android:layout_width="320dp"
            android:layout_height="56dp"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:hint="留空则不修改"
            android:textColorHint="@color/text_secondary"
            android:gravity="center"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/card_bg"
            android:layout_marginBottom="32dp"
            android:focusable="true"/>

        <TextView
            android:layout_width="720dp"
            android:layout_height="wrap_content"
            android:text="题库地址（开机 / 打开应用时自动拉取，填目录即可）"
            android:textSize="22sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/et_bank_url"
            android:layout_width="720dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textUri"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@drawable/card_bg"
            android:layout_marginBottom="12dp"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tv_bank_status"
            android:layout_width="720dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:text="题库状态"/>

        <Button
            android:id="@+id/btn_refresh_banks"
            android:layout_width="400dp"
            android:layout_height="72dp"
            android:text="立即更新题库"
            android:textSize="26sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_selector"
            android:focusable="true"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="400dp"
            android:layout_height="72dp"
            android:text="@string/save"
            android:textSize="26sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_selector"
            android:focusable="true"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_start"
            android:layout_width="400dp"
            android:layout_height="72dp"
            android:text="@string/start_service"
            android:textSize="26sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_selector"
            android:focusable="true"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="400dp"
            android:layout_height="72dp"
            android:text="@string/stop_service"
            android:textSize="26sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_selector"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tv_saved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="22sp"
            android:textColor="@color/correct_green"
            android:visibility="gone"
            android:text="已保存"/>
    </LinearLayout>
</ScrollView>
